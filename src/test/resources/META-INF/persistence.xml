<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- ND2: atskiras persistence unit testams. Naudojama H2 in-memory DB vietoj MySQL,
     todėl testams nereikia paleisto MySQL serverio. -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="wolt-test" transaction-type="RESOURCE_LOCAL">
        <class>com.example.courseprifs.model.User</class>
        <class>com.example.courseprifs.model.BasicUser</class>
        <class>com.example.courseprifs.model.Restaurant</class>
        <class>com.example.courseprifs.model.Driver</class>
        <class>com.example.courseprifs.model.Cuisine</class>
        <class>com.example.courseprifs.model.FoodOrder</class>
        <class>com.example.courseprifs.model.Chat</class>
        <class>com.example.courseprifs.model.Review</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
